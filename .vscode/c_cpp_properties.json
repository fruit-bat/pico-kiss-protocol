{
  "version": 4,
  "configurations": [
    {
      "name": "Linux",
      "includePath": [
        "${workspaceFolder}/**",
        "${workspaceFolder}/src",
        "${workspaceFolder}/include",
        "${workspaceFolder}/apps/monitor/src",
        "${workspaceFolder}/../pico-serial-proxy/include"
      ],
      "defines": [
        "_GNU_SOURCE",
        "_XOPEN_SOURCE=700"
      ],
      "compilerPath": "/usr/bin/gcc",
      "cStandard": "c11",
      "intelliSenseMode": "linux-gcc-x64",
      "browse": {
        "path": [
          "${workspaceFolder}/src",
          "${workspaceFolder}/apps/monitor/src",
          "${workspaceFolder}/../pico-serial-proxy/include"
        ]
      }
    }
  ]
}
